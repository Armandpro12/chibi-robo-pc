#include <windows.h>

// Icon of the executable (Explorer, shortcuts, Programs list) and of the game window: SDL 3 registers its window
// class with the first RT_GROUP_ICON resource of the executable (SDL_RegisterApp in
// src/video/windows/SDL_windowsevents.c, SDL 3.4.10), so the title bar and the taskbar show it too. Id 1, the only
// and lowest icon id: the default icon. Original pictogram drawn by tools/make_icon.py from icon.toml (no game art).
1 ICON "chibi-robo.ico"


VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      ""
            VALUE "FileDescription",  "Chibi-Robo! PC"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "chibi-robo"
            VALUE "OriginalFilename", "chibi-robo.exe"
            VALUE "ProductName",      "Chibi-Robo! PC"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
