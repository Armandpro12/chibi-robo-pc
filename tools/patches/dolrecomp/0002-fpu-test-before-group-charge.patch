+// True if the instruction raises "FPU unavailable" while MSR[FP] = 0.
+static bool instruction_tests_fpu(const PPCInst* inst) {
+    return !inst->embedded_data && ppc_op_uses_fpu(inst->op);
+}
+
+// Cycle charge of the group that starts at `inst`. "FPU unavailable" leaves the faulting instruction unexecuted
+// (SRR0 = its address) and execution resumes there, at the same label: charged before the MSR[FP] test, the group
+// would be paid once before the exception and once more on resumption. So, when the head of the group uses the FPU,
+// the test comes first and the charge only once the instruction can run. Returns true if the test was emitted.
+static bool emit_group_charge(FILE* out, const PPCInst* inst, u32 cycles) {
+    bool fpu_tested = instruction_tests_fpu(inst);
+    if (fpu_tested)
+        fprintf(out, "    if (!ppc_fp_available_inline(ctx, 0x%08Xu)) return;\n", inst->address);
+    fprintf(out, "    ctx->downcount -= %u;\n", cycles);
+    return fpu_tested;
+}
+
