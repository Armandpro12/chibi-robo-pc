diff --git a/lib/webgpu/software_adapter.cpp b/lib/webgpu/software_adapter.cpp
new file mode 100644
index 0000000..c522865
--- /dev/null
+++ b/lib/webgpu/software_adapter.cpp
@@ -0,0 +1,46 @@
+#include "software_adapter.hpp"
+
+#if defined(_WIN32) && (defined(DAWN_ENABLE_BACKEND_D3D12) || defined(DAWN_ENABLE_BACKEND_D3D11))
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <dawn/native/D3DBackend.h>
+#include <dxgi1_4.h>
+#include <wrl/client.h>
+
+namespace aurora::webgpu {
+const wgpu::ChainedStruct* software_adapter_option(wgpu::BackendType backend) {
+  if (backend != wgpu::BackendType::D3D12 && backend != wgpu::BackendType::D3D11) {
+    return nullptr;
+  }
+  // Dawn's D3D backends do not return their software adapter for forceFallbackAdapter ("No supported adapters"),
+  // but they take an adapter LUID: the DXGI adapter flagged as software (WARP, "Microsoft Basic Render Driver").
+  static dawn::native::d3d::RequestAdapterOptionsLUID option;
+  static bool found = false;
+  static bool searched = false;
+  if (!searched) {
+    searched = true;
+    Microsoft::WRL::ComPtr<IDXGIFactory1> factory;
+    if (SUCCEEDED(CreateDXGIFactory1(IID_PPV_ARGS(&factory)))) {
+      Microsoft::WRL::ComPtr<IDXGIAdapter1> adapter;
+      for (UINT i = 0; !found && factory->EnumAdapters1(i, &adapter) != DXGI_ERROR_NOT_FOUND; ++i) {
+        DXGI_ADAPTER_DESC1 desc{};
+        if (SUCCEEDED(adapter->GetDesc1(&desc)) && (desc.Flags & DXGI_ADAPTER_FLAG_SOFTWARE) != 0) {
+          option.adapterLUID = desc.AdapterLuid;
+          found = true;
+        }
+        adapter.Reset();
+      }
+    }
+  }
+  return found ? &option : nullptr;
+}
+} // namespace aurora::webgpu
+#else
+namespace aurora::webgpu {
+const wgpu::ChainedStruct* software_adapter_option(wgpu::BackendType) { return nullptr; }
+} // namespace aurora::webgpu
+#endif
diff --git a/lib/webgpu/software_adapter.hpp b/lib/webgpu/software_adapter.hpp
new file mode 100644
index 0000000..6038dc0
--- /dev/null
+++ b/lib/webgpu/software_adapter.hpp
@@ -0,0 +1,9 @@
+#pragma once
+
+#include <webgpu/webgpu_cpp.h>
+
+namespace aurora::webgpu {
+// Option to chain to the adapter request so that the backend returns its CPU (software) adapter, when the backend
+// needs one for that (Direct3D: the DXGI software adapter, by LUID); nullptr otherwise (forceFallbackAdapter alone).
+const wgpu::ChainedStruct* software_adapter_option(wgpu::BackendType backend);
+} // namespace aurora::webgpu
