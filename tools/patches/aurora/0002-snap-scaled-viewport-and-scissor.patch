+gfx::Viewport snap_mapped_viewport(const gfx::Viewport& logicalViewport, const gfx::Viewport& mapped) noexcept {
+  if (g_gxState.viewportPolicy == AURORA_VIEWPORT_NATIVE || !(logicalViewport.width > 0.f) ||
+      !(logicalViewport.height > 0.f)) {
+    return mapped;
+  }
+  // An edge on a whole logical pixel goes to the nearest target pixel boundary. At a non-integer scale, the mapped
+  // edge otherwise ends inside a line or column whose coverage then depends on the GPU, while the scissor and the
+  // EFB copies of the same logical rectangle count it in. Edges between logical pixels (field jitter) keep their
+  // exact position; at an integer scale nothing changes.
+  const float scaleX = mapped.width / logicalViewport.width;
+  const float scaleY = mapped.height / logicalViewport.height;
+  const auto edge = [](float logical, float target, float scale) {
+    return logical == std::floor(logical) ? static_cast<float>(snap_to_pixel(logical * scale)) : target;
+  };
+  const float left = edge(logicalViewport.left, mapped.left, scaleX);
+  const float top = edge(logicalViewport.top, mapped.top, scaleY);
+  const float right = edge(logicalViewport.left + logicalViewport.width, mapped.left + mapped.width, scaleX);
+  const float bottom = edge(logicalViewport.top + logicalViewport.height, mapped.top + mapped.height, scaleY);
+  gfx::Viewport out = mapped;
+  out.left = left;
+  out.top = top;
+  out.width = right - left;
+  out.height = bottom - top;
+  return out;
+}
