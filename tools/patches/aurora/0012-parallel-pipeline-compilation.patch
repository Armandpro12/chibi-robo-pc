+static SDL_ThreadPriority g_pipelineThreadPriority = SDL_THREAD_PRIORITY_NORMAL;
+
+static void pipeline_thread_main() {
+  if (g_pipelineThreadPriority != SDL_THREAD_PRIORITY_NORMAL &&
+      !SDL_SetCurrentThreadPriority(g_pipelineThreadPriority)) {
+    Log.warn("Failed to set the pipeline compilation thread priority: {}", SDL_GetError());
+  }
+  pipeline_worker();
+}
+
+static void start_pipeline_threads() {
+  // Default: half the logical processors, 1 to 8 (the game's own threads keep the other half).
+  size_t count = std::clamp<size_t>(std::thread::hardware_concurrency() / 2, 1, 8);
+  if (const char* env = std::getenv("AURORA_PIPELINE_THREADS"); env != nullptr) {
+    const long value = std::strtol(env, nullptr, 10);
+    count = value < 1 ? 1 : value > 16 ? 16 : static_cast<size_t>(value);
+  }
+#ifdef WEBGPU_DAWN
+  // Several threads call the device at the same time: assumed safe only when Dawn serializes its API calls.
+  if (count > 1 && !webgpu::g_device.HasFeature(wgpu::FeatureName::ImplicitDeviceSynchronization)) {
+    Log.warn("{} pipeline threads wanted, but ImplicitDeviceSynchronization is not enabled: using one", count);
+    count = 1;
+  }
+#else
+  count = 1;
+#endif
+  g_pipelineThreadPriority = SDL_THREAD_PRIORITY_HIGH;
+  if (const char* env = std::getenv("AURORA_PIPELINE_THREAD_PRIORITY"); env != nullptr) {
+    const std::string_view value{env};
+    if (value == "low") {
+      g_pipelineThreadPriority = SDL_THREAD_PRIORITY_LOW;
+    } else if (value == "normal") {
+      g_pipelineThreadPriority = SDL_THREAD_PRIORITY_NORMAL;
+    }
+  }
+  Log.info("Pipeline compilation: {} thread(s), priority {}", count,
+           g_pipelineThreadPriority == SDL_THREAD_PRIORITY_HIGH  ? "high"
+           : g_pipelineThreadPriority == SDL_THREAD_PRIORITY_LOW ? "low"
+                                                                 : "normal");
+  g_pipelineThreads.reserve(count);
+  for (size_t i = 0; i < count; ++i) {
+    g_pipelineThreads.emplace_back(pipeline_thread_main);
+  }
+}
