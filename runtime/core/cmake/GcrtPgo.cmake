# Optional profile-guided optimization (PGO, clang instrumentation). Driven by tools/build.py --pgo.
#
#   GCRT_PGO = OFF       (default) ordinary build;
#              GENERATE  instrumented C code (-fprofile-instr-generate); the executable writes a raw profile (.profraw)
#                        at the end of each run (variable LLVM_PROFILE_FILE); linked to clang's profiling runtime
#                        (GCRT_PGO_RUNTIME, clang_rt.profile-<arch>.lib);
#              USE       C code optimized according to GCRT_PGO_PROFILE (profile merged by llvm-profdata).
#
# Only the C code is affected (code generated by DolRecomp, cpu.c helpers, chassis, native replacements of the SDK):
# this is the measured configuration (notes/performance.md, post-10c section); the C++ (platform, GX bridge, Aurora)
# is not.
# The profile (function names, structure hashes, counters) is used only for our own builds: it stays local
# (build/pgo/<game>-<ID>/, produced by tools/pgo.py) and never goes into Git. A stale profile (code changed since
# training) remains usable: clang ignores the functions whose hash no longer matches and reports it (counted
# warning); only the gain drops.
set(GCRT_PGO "OFF" CACHE STRING "Profile-guided optimization: OFF, GENERATE or USE (tools/build.py --pgo)")
set_property(CACHE GCRT_PGO PROPERTY STRINGS OFF GENERATE USE)
set(GCRT_PGO_PROFILE "" CACHE FILEPATH "Merged profile (.profdata) for GCRT_PGO=USE")
set(GCRT_PGO_RUNTIME "" CACHE FILEPATH "clang profiling runtime (clang_rt.profile) for GCRT_PGO=GENERATE")

if(GCRT_PGO STREQUAL "GENERATE")
  if(NOT CMAKE_C_COMPILER_ID STREQUAL "Clang")
    message(FATAL_ERROR "GCRT_PGO=GENERATE requires clang (clang-cl)")
  endif()
  if(NOT EXISTS "${GCRT_PGO_RUNTIME}")
    message(FATAL_ERROR "GCRT_PGO=GENERATE: profiling runtime not found (\"${GCRT_PGO_RUNTIME}\")")
  endif()
  add_compile_options("$<$<COMPILE_LANGUAGE:C>:-fprofile-instr-generate>")
  # Executables only (the DLLs shipped with Aurora are not compiled here).
  add_link_options("$<$<STREQUAL:$<TARGET_PROPERTY:TYPE>,EXECUTABLE>:${GCRT_PGO_RUNTIME}>")
  message(STATUS "PGO: instrumenting the C code")
elseif(GCRT_PGO STREQUAL "USE")
  if(NOT CMAKE_C_COMPILER_ID STREQUAL "Clang")
    message(FATAL_ERROR "GCRT_PGO=USE requires clang (clang-cl)")
  endif()
  if(NOT EXISTS "${GCRT_PGO_PROFILE}")
    message(FATAL_ERROR "GCRT_PGO=USE: profile not found (\"${GCRT_PGO_PROFILE}\"): tools/build.py --pgo train")
  endif()
  # -Wprofile-instr-out-of-date: one line per file whose functions no longer match the profile (counted by
  # tools/build.py: functions with a stale profile); files never executed during training: no warning.
  add_compile_options("$<$<COMPILE_LANGUAGE:C>:-fprofile-instr-use=${GCRT_PGO_PROFILE}>"
                      "$<$<COMPILE_LANGUAGE:C>:-Wprofile-instr-out-of-date>"
                      "$<$<COMPILE_LANGUAGE:C>:-Wno-profile-instr-unprofiled>")
  # Ninja only recompiles when the command line changes: tools/build.py therefore names each profile after its
  # contents (hash in the file name), so a new profile recompiles all the C code.
  message(STATUS "PGO: profile ${GCRT_PGO_PROFILE}")
elseif(NOT GCRT_PGO STREQUAL "OFF")
  message(FATAL_ERROR "GCRT_PGO must be OFF, GENERATE or USE (\"${GCRT_PGO}\")")
endif()
