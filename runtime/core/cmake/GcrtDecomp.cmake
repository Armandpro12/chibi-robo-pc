# gcrt_add_decompiled_code(<target> SOURCE_DIR <dir>)
#
# Adds a game's decompiled C++ code (stage 2) to the executable <target>:
#   - every .cpp under <dir>, subfolders included (one file per original unit, in the folders of the original
#     split when the game has one), compiled in C++20 with floating-point contraction off (a PowerPC
#     multiply-add is written explicitly; a separate multiply then add must stay two roundings);
#   - the registration table of the version being built (GCRT_DECOMP_REGISTRY, generated by tools/build.py from the
#     game's functions.tsv: one address per decompiled function for that version). Without it (CMake run by hand), an
#     empty table: the decompiled functions are linked but none replaces its recompiled version.
# The game's C entry point calls gcrt_decomp_install_generated() (decomp/gc_abi_c.h) from its install callback.
function(gcrt_add_decompiled_code target)
  cmake_parse_arguments(ARG "" "SOURCE_DIR" "" ${ARGN})
  file(GLOB_RECURSE decomp_sources CONFIGURE_DEPENDS "${ARG_SOURCE_DIR}/*.cpp")
  list(SORT decomp_sources)
  if(GCRT_DECOMP_REGISTRY)
    if(NOT EXISTS "${GCRT_DECOMP_REGISTRY}")
      message(FATAL_ERROR "GCRT_DECOMP_REGISTRY not found: ${GCRT_DECOMP_REGISTRY} (run tools/build.py)")
    endif()
    set(registry "${GCRT_DECOMP_REGISTRY}")
  else()
    set(registry "${CMAKE_CURRENT_BINARY_DIR}/${target}_decomp_registry_empty.cpp")
    file(WRITE "${registry}"
      "// Empty registration table (CMake run without tools/build.py): no decompiled function is registered.\n"
      "#include \"decomp/gc_abi_c.h\"\n"
      "extern \"C\" void gcrt_decomp_install_generated(struct GcrtCpu* g) { (void)g; }\n")
  endif()
  # Negative test of the oracle (tools/build.py --oracle-negative): the deliberately wrong variants are built too, and
  # the generated table registers them instead of the functions themselves.
  if(GCRT_DECOMP_ORACLE AND GCRT_DECOMP_NEGATIVE_DIR)
    file(GLOB_RECURSE negative_sources CONFIGURE_DEPENDS "${GCRT_DECOMP_NEGATIVE_DIR}/*.cpp")
    list(SORT negative_sources)
    list(APPEND decomp_sources ${negative_sources})
  endif()
  list(LENGTH decomp_sources decomp_count)
  message(STATUS "${target}: ${decomp_count} decompiled source files, registry ${registry}")
  target_sources(${target} PRIVATE ${decomp_sources} "${registry}")
  if(MSVC)
    set_source_files_properties(${decomp_sources} PROPERTIES COMPILE_OPTIONS "/W4;/clang:-ffp-contract=off")
  else()
    set_source_files_properties(${decomp_sources} PROPERTIES COMPILE_OPTIONS "-Wall;-Wextra;-ffp-contract=off")
  endif()
endfunction()
